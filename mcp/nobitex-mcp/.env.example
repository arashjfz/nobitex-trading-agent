# ---------------------------------------------------------------------------
# Nobitex MCP server configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# mainnet | testnet
# Nobitex support says the testnet is currently disabled. For paper trading,
# keep mainnet: only public market data is fetched, never orders.
# testnet uses https://testnetapiv2.nobitex.ir when it is re-enabled.
NOBITEX_ENV=mainnet

# Optional explicit override. Takes precedence over NOBITEX_ENV.
# NOBITEX_BASE_URL=https://testnetapiv2.nobitex.ir

# --- Authentication (choose one) -------------------------------------------
# 1) User token: Authorization: Token <token>
# NOBITEX_TOKEN=

# 2) Ed25519 API key (recommended for bots)
# NOBITEX_PUBLIC_KEY=
# NOBITEX_PRIVATE_KEY=
# Optional: force auth mode when both are set: token | key
# NOBITEX_AUTH_MODE=key

# --- Safety ----------------------------------------------------------------
# When true, only read-only operations are allowed (trades/withdrawals blocked).
NOBITEX_READ_ONLY=false

# --- Paper trading ---------------------------------------------------------
# Simulate account/trading calls locally; no orders or withdrawals are sent.
# Recommended while the Nobitex testnet is disabled.
NOBITEX_DRY_RUN=false
# Starting paper balances (JSON). Keys are lowercase currency codes.
NOBITEX_PAPER_BALANCES={"usdt":"10000","rls":"100000000","btc":"0.5","eth":"5"}
# Paper fee rate; 0.001 = 0.1%
NOBITEX_PAPER_FEE_RATE=0.001

# --- Transport -------------------------------------------------------------
# stdio | streamable-http
NOBITEX_TRANSPORT=stdio
NOBITEX_HOST=127.0.0.1
NOBITEX_PORT=8000

# --- HTTP ------------------------------------------------------------------
NOBITEX_USER_AGENT=TraderBot/nobitex-mcp-1.0.0
NOBITEX_TIMEOUT=30
