# --- LLM (OpenHands SDK uses LiteLLM model names) -------------------------
LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
LLM_API_KEY=
# LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# --- Nobitex --------------------------------------------------------------
# mainnet | testnet
NOBITEX_ENV=mainnet
# NOBITEX_BASE_URL=https://testnetapiv2.nobitex.ir

# Auth option A: API token
NOBITEX_TOKEN=
# Auth option B: Ed25519 key pair
NOBITEX_PUBLIC_KEY=
NOBITEX_PRIVATE_KEY=
# token | key (auto-detected when empty)
NOBITEX_AUTH_MODE=

# --- Safety ---------------------------------------------------------------
# Paper trading is ON by default: orders are simulated locally.
NOBITEX_DRY_RUN=true
# Block all order placement and keep the agent read-only.
NOBITEX_READ_ONLY=false
# Also expose withdrawal / credential-management MCP tools.
ALLOW_WITHDRAWALS=false
AGENT_MAX_ITERATIONS=60

# --- Server ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
